{
  "name": "spec-sdlc-kit",
  "version": "0.1.0",
  "description": "Spec-driven SDLC for any AI coding tool (Claude Code, Codex, Gemini, Cursor, Windsurf, Antigravity). npx-installable: specs with EARS + traceability, phase gates, and enforcing hooks for Claude Code.",
