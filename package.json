    "templates/",
    "claude-code/",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shrinivasjawade/spec-sdlc.git"
  },
  "bugs": {
    "url": "https://github.com/shrinivasjawade/spec-sdlc/issues"
  },
  "homepage": "https://github.com/shrinivasjawade/spec-sdlc#readme",
  "keywords": [
    "sdlc",
    "spec-driven",
    "ears",
    "claude-code",
    "codex",
    "cursor",
    "windsurf",
